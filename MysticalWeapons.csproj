<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>MysticalWeapons</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <!-- Mod manager profile to build against and deploy to: Gale first, then r2modman -->
    <GaleBepInExDir>$(APPDATA)\com.kesomannen.gale\valheim\profiles\Default\BepInEx</GaleBepInExDir>
    <R2BepInExDir>$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx</R2BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == '' And Exists('$(GaleBepInExDir)\core\BepInEx.dll')">$(GaleBepInExDir)</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(R2BepInExDir)</BepInExDir>
    <!-- Gale names plugin folders Author-ModName -->
    <PluginFolder Condition="'$(BepInExDir)' == '$(GaleBepInExDir)'">OldManMods-MysticalWeapons</PluginFolder>
    <PluginFolder Condition="'$(PluginFolder)' == ''">MysticalWeapons</PluginFolder>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)\assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ManagedDir)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(ManagedDir)\netstandard.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the built plugin straight into the mod manager profile -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <MakeDir Directories="$(BepInExDir)\plugins\$(PluginFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\$(PluginFolder)" />
    <!-- Custom models shipped with the mod (models/<Prefab>.obj + textures + credits) -->
    <ItemGroup>
      <ShippedModel Include="models\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ShippedModel)" DestinationFiles="@(ShippedModel->'$(BepInExDir)\plugins\$(PluginFolder)\models\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Deployed to $(BepInExDir)\plugins\$(PluginFolder)" />
  </Target>

</Project>
